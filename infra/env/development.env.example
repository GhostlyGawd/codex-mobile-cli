# Local-only defaults. Copy to an ignored file; never commit populated secrets.
APP_ENV=development
DATA_ROOT=./.data
SECRETS_DIR=./.secrets
PUBLIC_BIND_ADDRESS=127.0.0.1
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
API_HOST=localhost
API_SITE_ADDRESS=http://localhost
BASE_DOMAIN=localhost
PREVIEW_DOMAIN=preview.localhost
PREVIEW_SITE_ADDRESS=http://*.preview.localhost
PASSKEY_RP_ID=localhost
PUBLIC_ORIGIN=http://localhost
PASSKEY_ORIGINS=http://localhost
PUBLIC_HEALTH_URL=http://localhost/healthz
GITHUB_ENABLED=false
APNS_ENABLED=false
# Optional GitHub App override (leave commented while disabled):
# GITHUB_APP_ID=123456
# GITHUB_CLIENT_ID=Iv1.ownerprovided
# GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_client_secret
# GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
# Required SECRETS_DIR files: github_client_secret, github_webhook_secret,
# github_app_private_key.
# Optional direct APNs override (leave commented while disabled):
# APNS_TEAM_ID=ABCDEFGHIJ
# APNS_KEY_ID_SANDBOX=ABCDEFGHIJ
# APNS_KEY_ID_PRODUCTION=KLMNOPQRST
# IOS_BUNDLE_ID=com.owner.codexmobile
# APNS_SANDBOX_PRIVATE_KEY_FILE=/run/secrets/apns_sandbox_private_key
# APNS_PRODUCTION_PRIVATE_KEY_FILE=/run/secrets/apns_production_private_key
# Required SECRETS_DIR files: apns_sandbox_private_key,
# apns_production_private_key.
CODER_BIND_ADDRESS=127.0.0.1
CODER_BIND_PORT=7080
CODER_ACCESS_URL=http://coder:7080
CODER_WORKSPACE_CONNECTIVITY_CONFIRMED=false
CODER_ORGANIZATION_ID=REPLACE_ME_AFTER_CODER_BOOTSTRAP
CODER_TEMPLATE_ID=REPLACE_ME_AFTER_TEMPLATE_IMPORT
CODER_OWNER_ID=me
POSTGRES_ADMIN_USER=codex_bootstrap_admin
APP_DB_USER=codex_app
APP_DB_NAME=codex_app
CODER_DB_USER=coder
CODER_DB_NAME=coder
CONTROL_PLANE_IMAGE_TAG=local-2026-07-15
CONTROL_PLANE_PACKAGE=./services/control-plane/cmd/control-plane
