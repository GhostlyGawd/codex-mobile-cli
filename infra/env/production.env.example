# Copy to /etc/codex-mobile/production.env with mode 0600. Every REPLACE_ME
# value is intentionally invalid until an operator supplies the final setting.
APP_ENV=production
DATA_ROOT=/srv/codex-mobile
SECRETS_DIR=/etc/codex-mobile/secrets
# Exact `findmnt -n -o SOURCE --target /srv/codex-mobile` output. The runtime,
# template import, and preflight all reject a guessed or mismatched device.
WORKSPACE_IO_DEVICE=REPLACE_ME_EXACT_DATA_MOUNT_SOURCE
# Dedicated Podman relay uplink. Choose a collision-free RFC1918 /24-/28;
# workspaces never attach to this network directly.
WORKSPACE_CONTROL_SUBNET=10.87.0.0/24

# Caddy is the only service permitted to bind a public address.
PUBLIC_BIND_ADDRESS=0.0.0.0
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
API_HOST=api.codex.REPLACE_ME.example
API_SITE_ADDRESS=api.codex.REPLACE_ME.example
BASE_DOMAIN=codex.REPLACE_ME.example
PREVIEW_DOMAIN=preview.codex.REPLACE_ME.example
PREVIEW_SITE_ADDRESS=*.preview.codex.REPLACE_ME.example
PASSKEY_RP_ID=codex.REPLACE_ME.example
PUBLIC_ORIGIN=https://api.codex.REPLACE_ME.example
PASSKEY_ORIGINS=https://api.codex.REPLACE_ME.example
PUBLIC_HEALTH_URL=https://api.codex.REPLACE_ME.example/healthz

# Integrations are fail-closed. The deployment wrapper selects a reviewed
# Compose override that mounts every corresponding *_FILE secret and identifier
# only when its flag is exactly true.
GITHUB_ENABLED=false
APNS_ENABLED=false

# To enable GitHub, change GITHUB_ENABLED to true, fill/uncomment every line,
# and place the three named root-owned mode-0444 files beneath the root-only
# mode-0700 SECRETS_DIR. The deployment
# wrapper then selects infra/compose.github.yaml automatically.
# GITHUB_APP_ID=REPLACE_ME_POSITIVE_INTEGER
# GITHUB_CLIENT_ID=REPLACE_ME_GITHUB_CLIENT_ID
# GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_client_secret
# GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
# GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
#
# To enable direct APNs, change APNS_ENABLED to true, fill/uncomment every line,
# and place both Apple .p8 keys beneath SECRETS_DIR as
# apns_sandbox_private_key and apns_production_private_key. The deployment
# wrapper then selects infra/compose.apns.yaml automatically.
# APNS_TEAM_ID=REPLACE_ME_APPLE_TEAM_ID
# APNS_KEY_ID_SANDBOX=REPLACE_ME_SANDBOX_KEY_ID
# APNS_KEY_ID_PRODUCTION=REPLACE_ME_PRODUCTION_KEY_ID
# IOS_BUNDLE_ID=REPLACE_ME_REVERSE_DNS_BUNDLE_ID
# APNS_SANDBOX_PRIVATE_KEY_FILE=/run/secrets/apns_sandbox_private_key
# APNS_PRODUCTION_PRIVATE_KEY_FILE=/run/secrets/apns_production_private_key

# The Linux host spike must establish a dedicated RFC1918 host address reached
# only through the rootful-Podman control relays. Never use loopback, 0.0.0.0,
# ::, or a public address in production.
CODER_BIND_ADDRESS=REPLACE_ME_PRIVATE_HOST_IP
CODER_BIND_PORT=7080
CODER_ACCESS_URL=http://REPLACE_ME_PRIVATE_HOST_IP:7080
CODER_WORKSPACE_CONNECTIVITY_CONFIRMED=false
CODER_ORGANIZATION_ID=REPLACE_ME_CODER_ORGANIZATION_UUID
CODER_TEMPLATE_ID=REPLACE_ME_IMPORTED_TEMPLATE_UUID
CODER_OWNER_ID=me

POSTGRES_ADMIN_USER=codex_bootstrap_admin
APP_DB_USER=codex_app
APP_DB_NAME=codex_app
CODER_DB_USER=coder
CODER_DB_NAME=coder

# Release automation must replace this with an immutable commit-derived tag.
CONTROL_PLANE_IMAGE_TAG=sha-REPLACE_ME
CONTROL_PLANE_PACKAGE=./services/control-plane/cmd/control-plane

# Deployment purchasing remains manual and owner-gated. These values are used
# only by the billing preflight; no script calls a provider provisioning API.
VPS_PROVIDER=REPLACE_ME
VPS_PLAN=REPLACE_ME
VPS_REGION=REPLACE_ME
VPS_MONTHLY_PRICE_USD=REPLACE_ME
VPS_FIXED_PRICE_CONFIRMED=false
VPS_INCLUDED_BACKUP_CONFIRMED=false
VPS_NO_AUTOMATIC_OVERAGE_CONFIRMED=false
