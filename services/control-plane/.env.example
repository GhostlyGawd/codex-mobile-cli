# Runtime mode: development or production.
APP_ENV=development
# Public HTTP listener for the Go service inside the private network.
HTTP_ADDR=:8080
# Metadata-only Prometheus text listener. Numeric loopback addresses are enforced.
METRICS_ADDR=127.0.0.1:9090
# Public HTTPS origin used for links and strict origin validation.
PUBLIC_ORIGIN=https://api.codex.example.com
# Stable WebAuthn relying-party identifier; changing it can require passkey re-enrollment.
PASSKEY_RP_ID=api.codex.example.com
# Comma-separated exact HTTPS WebAuthn origins.
PASSKEY_ORIGINS=https://api.codex.example.com

# Production secrets should use *_FILE and root-readable Docker secret files.
DATABASE_URL_FILE=/run/secrets/app_database_url
MASTER_KEY_FILE=/run/secrets/master_key
SESSION_PEPPER_FILE=/run/secrets/session_pepper
CODER_TOKEN_FILE=/run/secrets/coder_token
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github_app_private_key
APNS_SANDBOX_PRIVATE_KEY_FILE=/run/secrets/apns_sandbox_private_key
APNS_PRODUCTION_PRIVATE_KEY_FILE=/run/secrets/apns_production_private_key

# Private Coder API endpoint.
CODER_URL=http://coder:7080
CODER_ORGANIZATION_ID=REPLACE_ME
CODER_OWNER_ID=me
CODER_TEMPLATE_ID=REPLACE_ME_AFTER_TEMPLATE_PUSH
CODEX_APP_SERVER_EVENTS=false

# Weekly server-maintenance coordination (UTC). Urgent security runs still warn.
MAINTENANCE_ENABLED=true
MAINTENANCE_WEEKDAY=Sunday
MAINTENANCE_HOUR_UTC=4
MAINTENANCE_WARNING_LEAD=24h
MAINTENANCE_URGENT_WARNING_LEAD=5m
MAINTENANCE_SCAN_INTERVAL=1m
# GitHub App identifiers. Registration is an owner-gated external action.
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_client_secret
GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret

# Direct APNs configuration. TestFlight uses production APNs.
APNS_KEY_ID_SANDBOX=
APNS_KEY_ID_PRODUCTION=
APNS_TEAM_ID=
IOS_BUNDLE_ID=

# Deployment placeholders validated in production.
APP_DISPLAY_NAME=Codex Mobile
APPLE_TEAM_ID=
BASE_DOMAIN=
API_HOST=
PREVIEW_DOMAIN=
VPS_PROVIDER=
VPS_PLAN=
VPS_REGION=

# Development-only direct values. Production rejects these where a *_FILE option exists.
# DATABASE_URL=postgres://codex_mobile:password@127.0.0.1:5432/codex_mobile?sslmode=disable
# MASTER_KEY_B64=base64-encoded-32-byte-key
# SESSION_PEPPER_B64=base64-encoded-32-byte-key
